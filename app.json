{
  "expo": {
    "name": "don't text them",
    "slug": "dont-texthim",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "donttexthim",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3d1219"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.donttexthim.app",
      "buildNumber": "17",
      "infoPlist": {
        "CFBundleDisplayName": "don't text them",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.donttexthim.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3d1219"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "cc5e7a53-029a-4955-a67d-9680af351bcc"
      }
    },
    "owner": "leylaarc",
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/cc5e7a53-029a-4955-a67d-9680af351bcc"
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.donttexthim.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.donttexthim.app",
          "widgets": [
            {
              "name": "QuoteWidget",
              "displayName": "don't text them",
              "description": "Your reminder quote on the Home Screen.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ]
    ]
  }
}
