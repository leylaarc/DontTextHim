{
  "name": "donttexthim",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "privacy:html": "node scripts/renderPrivacyHtml.mjs",
    "postinstall": "patch-package",
    "prebuild": "expo prebuild && node scripts/fixExpoWidgetsXcodePaths.mjs",
    "eas-build-post-install": "node scripts/fixExpoWidgetsXcodePaths.mjs",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "submit:android": "npx eas-cli submit --platform android --profile production --latest"
  },
  "dependencies": {
    "@expo/ui": "55.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.0",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.22",
    "expo-widgets": "^55.0.18",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  }
}
